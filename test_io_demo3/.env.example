# 复制成 .env 后填自己的值：  Copy-Item .env.example .env
# 千万别把真实的 .env 提交进 git（.gitignore 已经挡住）

# ===================== 模型 =====================
DEEPSEEK_API_KEY=sk-你的key
# 必须和 langchain_deepseek 的 profile 表键名逐字符一致，否则 llm.profile 返回 None：
# 可选 deepseek-chat / deepseek-reasoner / deepseek-v4-flash / deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.5
# 可选：自建网关 / 代理地址，留空走 SDK 默认
# DEEPSEEK_BASE_URL=

SYSTEM_PROMPT=你是一个js逆向方面的专家

# ===================== 文件读取白名单 =====================
# os.pathsep 分隔（Windows 用 ;  Linux/macOS 用 :）
# 不配 = 所有读取都走人工确认。白名单必须显式声明，
# 不再有 expanduser("~/Documents") 那种"顺手把整个文档目录放行"的默认值。
IO_OX_ALLOWED_ROOTS=D:/pyhc/pythonn;E:/IO_OX-_test

# ===================== 上下文治理 =====================
# 触发比例 / 安全余量 / 成本线 / 保留条数 / 中文换算比例
# CONTEXT_EDIT_TRIGGER_RATIO=0.6
# CONTEXT_EDIT_SAFETY_MARGIN=16000
# CONTEXT_EDIT_COST_LINE=200000
# CONTEXT_EDIT_KEEP=3
# CONTEXT_EDIT_CHARS_PER_TOKEN=1.6
# 永不清理的工具（逗号分隔，留空表示全都可清）
# CONTEXT_EDIT_EXCLUDE_TOOLS=read_file
# 调试用：设成 1 表示每轮都触发清理，方便观察它到底改了什么
# CONTEXT_EDIT_TRIGGER=1
# 窗口兜底值；能读到 profile 时以 profile 的 max_input_tokens 为准
# CONTEXT_EDIT_WINDOW=1000000

# ===================== 启动校验开关 =====================
# 模型名查不到 profile 时是否直接启动失败（CI 里建议设 1）
# IO_OX_STRICT_MODEL=0
# 离线/测试环境跳过 ChatDeepSeek 导入
# IO_OX_SKIP_MODEL_IMPORT=1
